# Copy to .env and change the passwords: cp .env.example .env

# Registry and version (images are tagged <DOCKERHUB_USERNAME>/shop-<service>:<TAG>)
DOCKERHUB_USERNAME=your-dockerhub-username
TAG=v1.0.0

# Entry point
NGINX_HOST_PORT=8080
NGINX_PORT=8080

# Service ports (inside the Docker network)
GATEWAY_PORT=3000
PRODUCT_SERVICE_PORT=3000
ORDER_SERVICE_PORT=3000

# PostgreSQL
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=shop

# Redis (letters, numbers and dashes only: it is used inside a URL)
REDIS_PASSWORD=change-me-redis
CACHE_TTL_SECONDS=60

# Development only (docker-compose.override.yml)
GATEWAY_DEBUG_PORT=9229
PRODUCT_DEBUG_PORT=9230
ORDER_DEBUG_PORT=9231
POSTGRES_DEV_PORT=5432
